# Backend environment template for local development.
# Keep the real file outside Git and replace every CHANGE_ME value locally.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/evagita
SPRING_DATASOURCE_USERNAME=CHANGE_ME_LOCAL_DB_USER
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=CHANGE_ME_LOCAL_RABBITMQ_USER
RABBITMQ_PASSWORD=CHANGE_ME_LOCAL_RABBITMQ_PASSWORD

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_LOCAL_SECRET

SMARTCAPTCHA_ENABLED=false
SMARTCAPTCHA_SERVER_KEY=CHANGE_ME_SERVER_KEY
SMARTCAPTCHA_ALLOWED_HOSTS=localhost
SMARTCAPTCHA_EMAIL_SOFT_THRESHOLD=3
SMARTCAPTCHA_TIMEOUT_MS=2000
